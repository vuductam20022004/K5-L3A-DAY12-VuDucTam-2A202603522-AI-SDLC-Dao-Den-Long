{
  "name": "dao-den-long",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Đảo Đèn Lồng — game 3D gom đom đóm thắp đèn, né Bóng Mực (TypeScript + Three.js)",
  "scripts": {
    "dev": "vite",
    "start": "node dist/server.js",
    "build": "npm run typecheck && npm run build:web && npm run build:headless && npm run build:tools",
    "build:web": "vite build",
    "build:headless": "esbuild src/headless.ts --bundle --platform=node --format=esm --target=node18 --outfile=dist/headless.js",
    "build:tools": "esbuild src/server.ts src/soak.ts --bundle --platform=node --format=esm --target=node22 --outdir=dist",
    "bench": "node scripts/bench.mjs",
    "soak": "node --jitless --expose-gc dist/soak.js",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "headless": "node dist/headless.js",
    "verify": "node scripts/verify.mjs",
    "test:gui": "node scripts/gui-check.mjs",
    "demo": "node scripts/demo.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "test:clean": "node scripts/clean-install.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/three": "^0.170.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  },
  "dependencies": {
    "three": "^0.170.0"
  }
}
